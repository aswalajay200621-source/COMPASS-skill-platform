# COMPASS Database Environment Variables

# Choose Database Driver: 'sqlite' or 'postgres'
DB_TYPE=sqlite

# PostgreSQL Connection String (Local PostgreSQL or Supabase / Neon / Render)
# Local Example: postgresql://postgres:yourpassword@localhost:5432/compass_db
# Supabase Example: postgresql://postgres.xxxx:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compass_db

PORT=5000
